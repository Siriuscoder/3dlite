#include "samples:shaders/sources/common/common_inc.glsl"

layout(local_size_x = LITE3D_LIGHT_COMPUTE_THREADS_X, local_size_y = LITE3D_LIGHT_COMPUTE_THREADS_Y, local_size_z = 1) in;
layout(binding = 0, rgba32f) uniform writeonly image2D outputImage;

layout(std140) uniform LightSources
{
    LightSource lights[LITE3D_MAX_LIGHT_COUNT];
};

layout(std140) uniform LightIndexes
{
    ivec4 lightsIndexes[LITE3D_MAX_LIGHT_COUNT];
};

uniform samplerCube Skybox;
uniform float EmissionStrength;
uniform vec3 ClearColor;

#include "samples:shaders/sources/pbr/direct.glsl"
#include "samples:shaders/sources/ssao/ssao_sample.glsl"

/* Indirect lighting */
SufraceLighting EvaluateIBL(in Surface surface, in AngularInfo angular);

void main()
{
    const ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 bounds = ivec2(imageSize(outputImage).xy);

    // Skip unnecessary shader calls
    if (any(greaterThanEqual(pixelCoord, bounds)))
        return;

    const vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(bounds);
    Surface surface;
    if (!restoreSurface(uv, surface))
    {
        // Not a geometry
        vec3 sky = ClearColor;

#ifdef LITE3D_LIGHT_PASS_SKYBOX
        vec3 dir = screenUVToEnvDir(uv) * -1.0;
        sky = texture(Skybox, dir).rgb * EmissionStrength;
#endif
        imageStore(outputImage, pixelCoord, vec4(sky, 1.0));
        return;
    }

    SufraceLighting direct = SufraceLighting(vec3(0.0), vec3(0.0), vec3(0.0));

    AngularInfo angular;
    angularInfoInit(angular, surface);

    int count = lightsIndexes[0].x;
    for (int i = 1; i <= count; ++i)
    {
        int index = lightsIndexes[i / 4][i % 4];
        SufraceLighting sl = EvaluateDirectLight(lights[index], surface, angular);

        direct.diffuse += sl.diffuse;
        direct.specular += sl.specular;
    }

    // Calculate indirect lighting, ambient, IBL .. 
    SufraceLighting indirect = EvaluateIBL(surface, angular);
    // Total sum
    vec3 total = direct.diffuse + direct.specular + indirect.diffuse + indirect.specular + surface.material.emission.rgb;
    imageStore(outputImage, pixelCoord, vec4(total, 1.0));
}
