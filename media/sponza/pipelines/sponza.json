{
    "ShaderPackage": "sponza",
    "MainScenePath": "sponza:scenes/sponza.json",
    "Instancing": true,
    "OcclusionCulling": false,
    "LightingTechnique": "UBO",
    "MultiRender": true,
    "SkyBox": 
    {
        "Texture": "samples:textures/json/skybox.json",
        "EmissionStrength": 3.8
    },
    "ShadowMaps":
    {
        "Extent": 1024,
        "CascadeShadowCacheMaxCount": 4,
        "OmniShadowCacheMaxCount": 6
    },
    "SSAO": 
    {
        "AORadius": 0.25,
        "FramebufferScale": 2
    },
    "BLOOM": 
    {
        "BloomRadius": 0.005
    },
    "GI":
    {
        "ProbeResolution": 128,
        "MaxCount": 33,
        "ProbeZNearClip": 0.01,
        "ProbeZFarClip": 100.0
    },
    "PostProcess":
    {
        "Contrast": 1.005,
        "Saturation": 1.10,
        "Exposure": 2.0,
        "LensFlare": true,
        "ChromaticAberration": true,
        "DynamicExposure":
        {
            "ExposureMax": 12.0,
            "ExposureMin": 1.0,
            "ExposureBase": 0.34
        }
    }
}