{
    "ShaderPackage": "sponza",
    "MainScenePath": "sponza:scenes/sponza.json",
    "Instancing": true,
    "OcclusionCulling": false,
    "LightingTechnique": "UBO",
    "MultiRender": true,
    "SkyBox": 
    {
        "Texture": "samples:textures/json/skybox.json",
        "EmissionStrength": 4.0
    },
    "ShadowMaps":
    {
        "Extent": 1024,
        "CascadeShadowCacheMaxCount": 4,
        "OmniShadowCacheMaxCount": 6
    },
    "SSAO": 
    {
        "AORadius": 0.25,
        "FramebufferScale": 2
    },
    "BLOOM": 
    {
        "BloomRadius": 0.005
    },
    "GI":
    {
        "ProbeResolution": 128,
        "MaxCount": 33,
        "ProbeZNearClip": 0.01,
        "ProbeZFarClip": 100.0
    },
    "PostProcess":
    {
        "Gamma": 2.2,
        "Contrast": 1.005,
        "Saturation": 1.10,
        "Exposure": 1.0,
        "DynamicExposure":
        {
            "ExposureMax": 5.5,
            "ExposureMin": 0.7,
            "ExposureBase": 0.3
        }
    }
}